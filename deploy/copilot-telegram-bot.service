# Install with sudo as /etc/systemd/system/copilot-telegram-bot.service, then run:
# sudo systemctl daemon-reload && sudo systemctl enable --now copilot-telegram-bot
[Unit]
Description=Copilot Telegram repository bot

[Service]
Type=simple
User=localadmin
Group=localadmin
Environment=HOME=/home/localadmin
WorkingDirectory=/home/localadmin/repos/linux-copilot-bot
ExecStart=/usr/bin/make run
Restart=on-failure
RestartSec=10
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
