# Install as ~/.config/systemd/user/copilot-telegram-bot.service, then run:
# systemctl --user daemon-reload && systemctl --user enable --now copilot-telegram-bot
[Unit]
Description=Copilot Telegram repository bot

[Service]
Type=simple
WorkingDirectory=/home/localadmin/repos/linux-copilot-bot
ExecStart=/usr/bin/make run
Restart=on-failure
RestartSec=10
TimeoutStopSec=90

[Install]
WantedBy=default.target
