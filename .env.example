# Copy to .env (chmod 600) and fill in the required values.

# Required: token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Required: comma-separated numeric Telegram user ids with full administrative access.
TELEGRAM_ADMIN_IDS=
# Optional: comma-separated numeric Telegram user ids that may create and list apps and fix their own apps.
TELEGRAM_USER_IDS=
# Required: GitHub token with read/write access to repository contents. Creating repositories needs
# permission to create them for the owner; /delete also needs repository-delete permission.
GITHUB_TOKEN=

# Optional: GitHub user or organization for bare repository names (default: the token's account).
GITHUB_OWNER=
# Optional: app checkouts and local templates; eurofish is the default template.
REPOS_DIR=/home/localadmin/repos
# Optional: bot state and app logs.
STATE_DIR=~/.copilot-telegram-bot

# Optional: Copilot browser profile created by `make login`.
COPILOT_PROFILE=~/.copilot-repo-browser
# Optional: default provider/model label and inactivity timeout in seconds.
COPILOT_MODEL=GPT/GPT-6
COPILOT_TIMEOUT=900
# Optional: true shows Chromium when a display is available; otherwise it runs hidden (default: false).
# Override one request with the `browser` or `nobrowser` /fix option.
BOT_SHOW_BROWSER=false
# Optional: false keeps Copilot chats in your account history (default: true).
# Override one request with the `tempchat` or `notempchat` /fix option.
BOT_TEMPORARY_CHAT=true

# Optional: seconds `make run` must stay up (or exit 0) to count as a successful redeploy.
DEPLOY_SETTLE_SECONDS=10

# Required for /new and /cloudflare; /delete needs it only for tunnel-route cleanup.
# Requires Account/Cloudflare Tunnel/Edit and Zone/DNS/Edit permissions.
# Routes always use kurwalab-tunnel and <subdomain>.kurwalab.fyi.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# Optional: identity on commits made by the bot.
GIT_AUTHOR_NAME=Copilot Telegram Bot
GIT_AUTHOR_EMAIL=copilot-telegram-bot@users.noreply.github.com
